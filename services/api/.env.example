# Copy to .env and fill in. Required vars throw at startup if missing.

# --- Required ---

# Comma-separated list of Kafka brokers (host:port).
KAFKA_BROKERS=localhost:9092

# Comma-separated list of Cassandra contact points (hosts).
CASSANDRA_CONTACT_POINTS=127.0.0.1

# --- Optional (defaults shown) ---

# Cassandra
CASSANDRA_DC=dc1
CASSANDRA_KEYSPACE=ai_incident_intel

# Kafka topics
KAFKA_TOPIC_EVENTS=incident-events
KAFKA_TOPIC_ENRICHED=incident-enriched
KAFKA_TOPIC_DLQ=incident-events-dlq

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=incident-artifacts

# Ports
API_PORT=4000
METRICS_PORT_PROJECTION=9100
METRICS_PORT_ENRICHMENT=9101

# Gemini (optional — summaries and similar-incident retrieval are disabled if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Logging
LOG_LEVEL=info
NODE_ENV=development
